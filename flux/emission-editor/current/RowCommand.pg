module RowCommand
// Task5 S4a, design-r7 §3.2 / §3.2a / §3.5 (incl. r2 I1/I3/I5/M1/M2/M3, r3 N3/N5/N10, r5 D6, r6 Q3/Q4/Q5/S3-M-6,
// r7 M-1 "RESTORE の結果と応答", r7 M-6) and controller ruling r7-note1 (a CLOSE write OnFail never answers OK).
// Per-row command handler and the per-row "現在値を受け入れて閉じる" press.
// Commands: FireOnValueChange<int>(OnlyForUser=CommandUser, Value=CommandSeq). A command is handled only when
// ActiveGeneration, CommandUser == LocalUser, AckSeq != CommandSeq and Intent/CommandKind match (Intent 1: CHECK or
// CLOSE, Intent 2/3/4: RESTORE, Intent 5: STATUS); anything else gets no response (Commit times out, fail-closed).
// The seq is captured, AckSeq <- seq, the command is processed synchronously, and the response is counted only while
// CommandSeq == seq: the classification counter first (AckWait/AckRefuse/AckFail; OK has none), then AckRemaining-1.
// The only Source write (FieldAsVariable) is RESTORE ⑥ (Source <- Original). It is reached only for a row with a
// record that is not ②' (current == Original in all 5 components), has a non-null SourceField, passes ① (in-flight
// operation reconciled), ③ (known-use guard, evaluated in this impulse) and ④ (current == LastApplied), after the
// write-ahead record; success only by the 5-component readback. CHECK, CLOSE, STATUS and the accept press never write
// the Source (accept and STATUS never read it either). Records are written through mutable ports. No Drive of the
// Source; no per-frame entrypoint. Outputs: CanAccept (the accept press condition) and Visible (row view IsActive).
in ActiveGeneration: bool
in Selected: bool
in Operator: FrooxEngine.User
in UiReady: bool
in Ready: bool
in Busy: bool
in Intent: int mutable
in OperationStage: int mutable
in EditEpoch: int
in SnapshotEpoch: int mutable
in SelectedRoot: FrooxEngine.Slot
in CommandUser: FrooxEngine.User
in CommandSeq: int
in CommandKind: int
in Valid: bool
in Draft: colorX
in Original: colorX
in SourceField: FrooxEngine.IValue<colorX>
in Provider: FrooxEngine.IAssetProvider<FrooxEngine.Material>
in AcceptButton: FrooxEngine.UIX.Button element
in List0: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index0: int
in List1: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index1: int
in List2: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index2: int
in List3: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index3: int
in List4: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index4: int
in List5: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index5: int
in List6: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index6: int
in List7: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index7: int
in List8: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index8: int
in List9: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index9: int
in List10: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index10: int
in List11: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index11: int
in List12: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index12: int
in List13: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index13: int
in List14: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index14: int
in List15: FrooxEngine.SyncAssetList<FrooxEngine.Material>
in Index15: int
in LastApplied: colorX mutable
in PreviewWritten: bool mutable
in RecoveryPending: bool mutable
in RowPending: bool mutable
in InputSeq: int mutable
in AppliedSeq: int mutable
in Result: int mutable
in ResultSeq: int
in OpStage: int mutable
in OpKind: int mutable
in OpSeq: int mutable
in OpId: int mutable
in PendingPrevious: colorX mutable
in PendingCandidate: colorX mutable
in AckSeq: int mutable
in InputR: string mutable
in InputG: string mutable
in InputB: string mutable
in AckRemaining: int mutable
in AckWait: int mutable
in AckRefuse: int mutable
in AckFail: int mutable
out CanAccept: bool
out Visible: bool
where {
    // Result codes (§3.5): 0 UNCHANGED, 1 PREVIEWED, 2 RESTORED, 3 COMMITTED, 4 ACCEPTED, 10 INVALID, 11 BLOCKED,
    // 12 CONFLICT, 13 GUARD, 20 FAILED, 21 STATE_FAILED. CommandKind: 1 CHECK, 2 CLOSE, 3 RESTORE, 4 STATUS.
    // OpStage: 0 idle, 1 prepared (may have written), 2 OnWritten received. OpKind: 1 preview, 2 restore.
    _source = FieldAsVariable<colorX>(Field=SourceField);
    _fresh = ValueSource<colorX>(Source=asDrivenGlobal(SourceField));
    _culture = as<System.IFormatProvider>(InvariantCulture);

    // eq(a, b): R, G, B, A and Profile compared individually (never colorX == alone).
    _dp = Unpack_ColorX(V=Draft);
    _lp = Unpack_ColorX(V=LastApplied);
    _fp = Unpack_ColorX(V=_fresh);
    _cp = Unpack_ColorX(V=PendingCandidate);
    _pp = Unpack_ColorX(V=PendingPrevious);
    _op = Unpack_ColorX(V=Original);
    _draftIsLast = _dp.R == _lp.R and _dp.G == _lp.G and _dp.B == _lp.B and _dp.A == _lp.A and _dp.Profile == _lp.Profile;
    _freshIsLast = _fp.R == _lp.R and _fp.G == _lp.G and _fp.B == _lp.B and _fp.A == _lp.A and _fp.Profile == _lp.Profile;
    _freshIsCandidate = _fp.R == _cp.R and _fp.G == _cp.G and _fp.B == _cp.B and _fp.A == _cp.A
        and _fp.Profile == _cp.Profile;
    _freshIsPrevious = _fp.R == _pp.R and _fp.G == _pp.G and _fp.B == _pp.B and _fp.A == _pp.A
        and _fp.Profile == _pp.Profile;
    _freshIsOriginal = _fp.R == _op.R and _fp.G == _op.G and _fp.B == _op.B and _fp.A == _op.A
        and _fp.Profile == _op.Profile;

    // Known-use guard: the registered list holds the registered material at the registered index, for every use.
    _e0 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List0, Index=Index0);
    _g0 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List0) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e0)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e0, B=Provider);
    _e1 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List1, Index=Index1);
    _g1 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List1) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e1)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e1, B=Provider);
    _e2 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List2, Index=Index2);
    _g2 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List2) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e2)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e2, B=Provider);
    _e3 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List3, Index=Index3);
    _g3 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List3) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e3)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e3, B=Provider);
    _e4 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List4, Index=Index4);
    _g4 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List4) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e4)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e4, B=Provider);
    _e5 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List5, Index=Index5);
    _g5 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List5) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e5)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e5, B=Provider);
    _e6 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List6, Index=Index6);
    _g6 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List6) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e6)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e6, B=Provider);
    _e7 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List7, Index=Index7);
    _g7 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List7) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e7)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e7, B=Provider);
    _e8 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List8, Index=Index8);
    _g8 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List8) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e8)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e8, B=Provider);
    _e9 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List9, Index=Index9);
    _g9 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List9) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e9)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e9, B=Provider);
    _e10 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List10, Index=Index10);
    _g10 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List10) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e10)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e10, B=Provider);
    _e11 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List11, Index=Index11);
    _g11 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List11) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e11)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e11, B=Provider);
    _e12 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List12, Index=Index12);
    _g12 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List12) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e12)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e12, B=Provider);
    _e13 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List13, Index=Index13);
    _g13 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List13) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e13)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e13, B=Provider);
    _e14 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List14, Index=Index14);
    _g14 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List14) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e14)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e14, B=Provider);
    _e15 = GetAtObject<FrooxEngine.SyncAssetList<FrooxEngine.Material>,FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Collection=List15, Index=Index15);
    _g15 = not IsNull<FrooxEngine.SyncAssetList<FrooxEngine.Material>>(Instance=List15) and not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=_e15)
        and ObjectEquals<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(A=_e15, B=Provider);
    _guard = not IsNull<FrooxEngine.IAssetProvider<FrooxEngine.Material>>(Instance=Provider)
        and _g0 and _g1 and _g2 and _g3
        and _g4 and _g5 and _g6 and _g7
        and _g8 and _g9 and _g10 and _g11
        and _g12 and _g13 and _g14 and _g15;

    // Shorthands (§3.2). A null SourceField is tested before any ValueSource comparison is evaluated.
    _sourceNull = IsNull<FrooxEngine.IValue<colorX>>(Instance=SourceField);
    _record = PreviewWritten or RowPending or OpStage != 0;
    _waiting = AppliedSeq != InputSeq and ResultSeq != InputSeq;
    _editing = Selected and SnapshotEpoch == EditEpoch;

    // §3.2a CanAccept and the press condition are the same expression (re-evaluated inside the press impulse).
    _acceptAllowed = Operator == LocalUser and ActiveGeneration and UiReady and Ready and not Busy and Intent == 0
        and OperationStage == 0 and RowPending;
    CanAccept = _acceptAllowed;
    // §2 R-visible (r7 M-6): an accepted row stays shown only while no avatar is selected.
    _acceptedShown = Result == 4 and SnapshotEpoch == -1 and IsNull<FrooxEngine.Slot>(Instance=SelectedRoot);
    Visible = ActiveGeneration and (Selected or RowPending or _acceptedShown);

    local _seq: int;

    // Responses: counted only while the command is still current (CommandSeq == seq); counter first, then remaining.
    _ackDone = ValueDecrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=AckRemaining);
    _respondOk = if CommandSeq == _seq then _ackDone;
    _respondWait = if CommandSeq == _seq then switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=AckWait)
        | OnWritten |> _ackDone;
    _respondRefuse = if CommandSeq == _seq then switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=AckRefuse)
        | OnWritten |> _ackDone;
    _respondFail = if CommandSeq == _seq then switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=AckFail)
        | OnWritten |> _ackDone;

    // 21 path (RESTORE table row "記録の書き込みの OnFail"; r7-note1 for CLOSE): try Result <- 21 first, then
    // RecoveryPending and RowPending regardless of the outcome; the answer stays FAIL (or REFUSE), never OK.
    _f21Row = switch (RowPending <- true)
        | OnWritten |> _respondFail
        | OnFail |> _respondFail;
    _f21Flags = switch (RecoveryPending <- true)
        | OnWritten |> _f21Row
        | OnFail |> _f21Row;
    _fail21 = switch (Result <- 21)
        | OnWritten |> _f21Flags
        | OnFail |> _f21Flags;
    _r21Row = switch (RowPending <- true)
        | OnWritten |> _respondRefuse
        | OnFail |> _respondRefuse;
    _r21Flags = switch (RecoveryPending <- true)
        | OnWritten |> _r21Row
        | OnFail |> _r21Row;
    _refuse21 = switch (Result <- 21)
        | OnWritten |> _r21Flags
        | OnFail |> _r21Flags;

    // ---- CHECK (§3.2 table): first match. Writes only AckSeq and the classification counters (controller ruling Q2,
    // design C17/C4): a refusal keeps the reason already in the row's Result (written by RowPreview); no Result write.
    // Ruling Q1: a row with a record and a null SourceField is refused (GUARD) before ValueSource is compared.
    _ckRecord = if _sourceNull or not _guard then _respondRefuse
        else if not _freshIsLast then _respondRefuse
        else _respondOk;
    _check = if RowPending then _respondRefuse
        else if OpStage != 0 then _respondWait
        else if _editing and _waiting then _respondWait
        else if _editing and not Valid then _respondRefuse
        else if _editing and not _draftIsLast then _respondRefuse
        else if _record then _ckRecord
        else _respondOk;

    // ---- CLOSE (§3.2 table, r7-note1): record rows only: COMMITTED -> SnapshotEpoch -1 -> PreviewWritten false
    // (last); then _invalidate for every row. A record-closing write OnFail -> 21 path, FAIL; an _invalidate OnFail ->
    // FAIL only, no Result/record flags (ruling Q3). Never OK.
    _clApplied = switch (AppliedSeq <- InputSeq)
        | OnWritten |> _respondOk
        | OnFail |> _respondFail;
    _clInvalidate = switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=InputSeq)
        | OnWritten |> _clApplied
        | OnFail |> _respondFail;
    _clMarked = switch (PreviewWritten <- false)
        | OnWritten |> _clInvalidate
        | OnFail |> _fail21;
    _clEpoch = switch (SnapshotEpoch <- -1)
        | OnWritten |> _clMarked
        | OnFail |> _fail21;
    _clCommit = switch (Result <- 3)
        | OnWritten |> _clEpoch
        | OnFail |> _fail21;
    // Guard and comparison once more; a failure refuses and leaves the record open (no reason written).
    _clRecord = if _sourceNull or not _guard then _respondRefuse
        else if not _freshIsLast then _respondRefuse
        else _clCommit;
    _closeCommand = if RowPending or OpStage != 0 then _respondRefuse
        else if _editing and (_waiting or not Valid or not _draftIsLast) then _respondRefuse
        else if _record then _clRecord
        else _clInvalidate;

    // ---- RESTORE (§3.2 table and "RESTORE の結果と応答"). Flags RecoveryPending -> RowPending, then Result.
    _rgResult = switch (Result <- 13)
        | OnWritten |> _respondRefuse
        | OnFail |> _refuse21;
    _rgRow = switch (RowPending <- true)
        | OnWritten |> _rgResult
        | OnFail |> _refuse21;
    _refuseGuard = switch (RecoveryPending <- true)
        | OnWritten |> _rgRow
        | OnFail |> _refuse21;
    _rcfResult = switch (Result <- 12)
        | OnWritten |> _respondRefuse
        | OnFail |> _refuse21;
    _rcfRow = switch (RowPending <- true)
        | OnWritten |> _rcfResult
        | OnFail |> _refuse21;
    _refuseConflict = switch (RecoveryPending <- true)
        | OnWritten |> _rcfRow
        | OnFail |> _refuse21;
    _rfResult = switch (Result <- 20)
        | OnWritten |> _respondFail
        | OnFail |> _fail21;
    _rfRow = switch (RowPending <- true)
        | OnWritten |> _rfResult
        | OnFail |> _fail21;
    _restoreFailed = switch (RecoveryPending <- true)
        | OnWritten |> _rfRow
        | OnFail |> _fail21;

    // _close(Original): LastApplied -> OpStage 0 -> RowPending false -> inputs -> PreviewWritten false (last); then
    // RESTORED and OK. Any OnFail -> 21 path, FAIL (the record stays open: PreviewWritten is written last).
    _ccResult = switch (Result <- 2)
        | OnWritten |> _respondOk
        | OnFail |> _fail21;
    _ccMarked = switch (PreviewWritten <- false)
        | OnWritten |> _ccResult
        | OnFail |> _fail21;
    _ccB = switch (InputB <- ToString_Float(V=_op.B, Format="R", FormatProvider=_culture))
        | OnWritten |> _ccMarked
        | OnFail |> _fail21;
    _ccG = switch (InputG <- ToString_Float(V=_op.G, Format="R", FormatProvider=_culture))
        | OnWritten |> _ccB
        | OnFail |> _fail21;
    _ccR = switch (InputR <- ToString_Float(V=_op.R, Format="R", FormatProvider=_culture))
        | OnWritten |> _ccG
        | OnFail |> _fail21;
    _ccRow = switch (RowPending <- false)
        | OnWritten |> _ccR
        | OnFail |> _fail21;
    _ccIdle = switch (OpStage <- 0)
        | OnWritten |> _ccRow
        | OnFail |> _fail21;
    _closeOriginal = switch (LastApplied <- Original)
        | OnWritten |> _ccIdle
        | OnFail |> _fail21;

    // ②' current == Original (5 components): close without writing the Source (OpId++ if an operation was open).
    _rsSame = if OpStage != 0 then switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=OpId)
        | OnWritten |> _closeOriginal
        | OnFail |> _fail21
        else _closeOriginal;

    // ⑥ write-ahead record, then the Source (the only FieldAsVariable write of this module), then the readback.
    _rsUnapplied = switch (OpStage <- 0)
        | OnWritten |> _restoreFailed
        | OnFail |> _fail21;
    _rsVerify = if _freshIsOriginal then _closeOriginal
        else if _freshIsPrevious then _rsUnapplied
        else _restoreFailed;
    _rsWritten = switch (OpStage <- 2)
        | OnWritten |> _rsVerify
        | OnFail |> _fail21;
    _rsSourceFailed = if _freshIsPrevious then _rsUnapplied else _restoreFailed;
    _rsSource = switch (_source <- Original)
        | OnWritten |> _rsWritten
        | OnFail |> _rsSourceFailed;
    _rsStage = switch (OpStage <- 1)
        | OnWritten |> _rsSource
        | OnFail |> _fail21;
    _rsId = switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=OpId)
        | OnWritten |> _rsStage
        | OnFail |> _fail21;
    _rsSeq = switch (OpSeq <- InputSeq)
        | OnWritten |> _rsId
        | OnFail |> _fail21;
    _rsKind = switch (OpKind <- 2)
        | OnWritten |> _rsSeq
        | OnFail |> _fail21;
    _rsCandidate = switch (PendingCandidate <- Original)
        | OnWritten |> _rsKind
        | OnFail |> _fail21;
    _rsWrite = switch (PendingPrevious <- LastApplied)
        | OnWritten |> _rsCandidate
        | OnFail |> _fail21;

    // ③ known-use guard (13), ④ current == LastApplied (12), otherwise ⑥.
    _rsChecked = if not _guard then _refuseGuard
        else if not _freshIsLast then _refuseConflict
        else _rsWrite;

    // ① an open operation is reconciled first (OpId++ every time): current == Candidate -> reflected
    // (LastApplied <- Candidate), == Previous -> not reflected, otherwise CONFLICT.
    _rnReflectedId = switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=OpId)
        | OnWritten |> _rsChecked
        | OnFail |> _fail21;
    _rnReflected = switch (LastApplied <- PendingCandidate)
        | OnWritten |> _rnReflectedId
        | OnFail |> _fail21;
    _rnUnreflected = switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=OpId)
        | OnWritten |> _rsChecked
        | OnFail |> _fail21;
    _rnConflict = switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=OpId)
        | OnWritten |> _refuseConflict
        | OnFail |> _fail21;
    _reconcile = if _freshIsCandidate then _rnReflected
        else if _freshIsPrevious then _rnUnreflected
        else _rnConflict;

    // ② no record -> OK; ②' (needs a non-null SourceField) before the null refusal (13), ① and ③④⑥.
    _rsBody = if not _record then _respondOk
        else if _sourceNull then _refuseGuard
        else if _freshIsOriginal then _rsSame
        else if OpStage != 0 then _reconcile
        else _rsChecked;
    // Entry _invalidate (InputSeq++ -> AppliedSeq <- InputSeq) whatever the branch; OnFail -> FAIL only, no
    // Result/record flags (ruling Q3).
    _rsApplied = switch (AppliedSeq <- InputSeq)
        | OnWritten |> _rsBody
        | OnFail |> _respondFail;
    _restore = switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=InputSeq)
        | OnWritten |> _rsApplied
        | OnFail |> _respondFail;

    // ---- STATUS (§3.2 table, D6): writes nothing but AckSeq and the counters.
    _status = if RowPending or OpStage != 0 then _respondRefuse
        else if PreviewWritten then _respondWait
        else _respondOk;

    // ---- Command entry.
    _kindMatches = (Intent == 1 and (CommandKind == 1 or CommandKind == 2))
        or ((Intent == 2 or Intent == 3 or Intent == 4) and CommandKind == 3)
        or (Intent == 5 and CommandKind == 4);
    _dispatch = if CommandKind == 1 then _check
        else if CommandKind == 2 then _closeCommand
        else if CommandKind == 3 then _restore
        else if CommandKind == 4 then _status;
    _acked = switch (AckSeq <- _seq)
        | OnWritten |> _dispatch;
    _command = if ActiveGeneration and CommandUser == LocalUser and AckSeq != CommandSeq and _kindMatches then impulse {
        bind _cm0 = (_seq <- CommandSeq).OnWritten;
        _acked;
    };

    // ---- 現在値を受け入れて閉じる (§3.2a). 1. Stage <- 1 (OnFail: nothing). 2. _accept: SnapshotEpoch -1 ->
    // (OpId++ if OpStage != 0) -> OpStage 0 -> ACCEPTED -> RowPending false -> PreviewWritten false -> _invalidate;
    // a record-closing write OnFail -> try STATE_FAILED and RowPending true; an _invalidate OnFail -> step 3 without
    // them (controller ruling (a), 08:50:00Z). 3. Intent <- 5 (last); OnFail -> Stage <- 0.
    // Never reads or writes the Source, Original, LastApplied, the inputs, PreviewActive or RecoveryPending.
    _acStageBack = OperationStage <- 0;
    _acIntent = switch (Intent <- 5)
        | OnFail |> _acStageBack;
    _afRow = switch (RowPending <- true)
        | OnWritten |> _acIntent
        | OnFail |> _acIntent;
    _acceptFailed = switch (Result <- 21)
        | OnWritten |> _afRow
        | OnFail |> _afRow;
    _acApplied = switch (AppliedSeq <- InputSeq)
        | OnWritten |> _acIntent
        | OnFail |> _acIntent;
    _acInvalidate = switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=InputSeq)
        | OnWritten |> _acApplied
        | OnFail |> _acIntent;
    _acMarked = switch (PreviewWritten <- false)
        | OnWritten |> _acInvalidate
        | OnFail |> _acceptFailed;
    _acRow = switch (RowPending <- false)
        | OnWritten |> _acMarked
        | OnFail |> _acceptFailed;
    _acResult = switch (Result <- 4)
        | OnWritten |> _acRow
        | OnFail |> _acceptFailed;
    _acIdle = switch (OpStage <- 0)
        | OnWritten |> _acResult
        | OnFail |> _acceptFailed;
    _acId = if OpStage != 0 then switch ValueIncrement<FrooxEngine.ProtoFlux.FrooxEngineContext,int>(Variable=OpId)
        | OnWritten |> _acIdle
        | OnFail |> _acceptFailed
        else _acIdle;
    _accept = switch (SnapshotEpoch <- -1)
        | OnWritten |> _acId
        | OnFail |> _acceptFailed;
    _acceptPress = if _acceptAllowed then switch (OperationStage <- 1)
        | OnWritten |> _accept;

    FireOnValueChange<int>(OnlyForUser=CommandUser, Value=CommandSeq, OnChanged=_command);
    _acceptButton = as<FrooxEngine.IButton>(AcceptButton);
    ButtonEvents(Button=asDrivenGlobal(_acceptButton), Pressed=_acceptPress);
}
