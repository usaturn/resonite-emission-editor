<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <Target Name="RequireSdkDirectory" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SdkDirectory)' == ''" Text="SdkDirectory must identify the installed Flux SDK DLL directory." />
  </Target>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <Reference Include="$(SdkDirectory)/FluxSDK.*.dll" />
    <Reference Include="$(SdkDirectory)/FSharp.Core.dll" />
    <Reference Include="$(SdkDirectory)/ResoniteLink.dll" />
    <Reference Include="$(SdkDirectory)/ResoniteLink.RPath.dll" />
  </ItemGroup>
</Project>
